_ENV = Dora
import global
import "UI.InputButton"
import "UI.View.Interaction"
Fit = require "UI.FitInteraction"

-- [signals]
-- "Tapped", (buttonIndex)->
-- [params]
-- text, buttons:{{text,textBG}}
export default Class Interaction,
	__init: (args)=>
		{:buttons = {}} = args
		index = 1
		for {text, textBG} in *buttons
			buttonIndex = index
			@menu\addChild with InputButton :text, textBG: textBG or ""
				@menu.enabled = false
				\slot "Tapped", -> @emit "Tapped", buttonIndex
			index += 1
		size = @menu\alignItems 5
		@menu.size = size
		@menu\alignItems 5
		@slot "Remove", -> @removeFromParent!
		title = @children.first
		Fit.title title, args.fliped
		@screenBoundsTargets = {title, title.children.last, @menu}
		require("UI.KeepOnScreen") @, @screenBoundsTargets

	show: =>
		@menu.enabled = true
		@perform Spawn(
			Opacity 0.2, 0, 1
			Y 0.2, 220, 200, Ease.OutQuad
		)

	hide: (remove = true)=>
		@menu.enabled = false
		fadeOut = Spawn(
			Opacity 0.2, 1, 0
			Y 0.2, 200, 220, Ease.InQuad
		)
		@perform if remove
			Sequence(
				fadeOut
				Event "Remove"
			)
		else
			fadeOut
