_ENV = Dora
import global
import "UI.View.Story"
import "UI.StoryPortrait"
import "UI.Answer"
import "Utils" as :Struct
import "YarnRunner"
import "Data.Config"
import "System.Command"

Dialog = Struct.Story.Dialog "character", "name", "text"

getCharName = (current) ->
	if current.marks
		for mark in *current.marks
			switch mark when {name: attr, attrs: {:name = '', :id = ''}}
				if attr in ["char", "Character"]
					id = Config.char if id == "char"
					return name, id
	'', ''

export default Class Story,
	reviewVisible: property => @_reviewVisible,
		(value)=>
			@_reviewVisible = value
			@reviewMask.visible = value
			@topCenter.visible = value
			@reviewBack.visible = value
			@reviewArea.visible = value

	advance: (option) =>
		action, result = @_runner\advance option
		switch action when "Text"
			if result.optionsFollowed
				_, @_options = @_runner\advance!
			else
				@_options = nil
			@_current = result
			return true
		when "Command"
			@_current = nil
			@_options = nil
			@answerList\removeAllChildren!
			@continueIcon.visible = true
			@_advancing = true
			switch result when :preload
				@_preload = preload
				return @advance!
			return true
		when "Error"
			print result
			return false
		else
			return false

	__init: (dialogFile) =>
		@_runner = YarnRunner dialogFile, "Start", Config, Command
		@advance!
		@reviewVisible = false
		-- A first command keeps ownership until its Story.Advance event.
		@_advancing = @_current == nil
		nextSentence = ->
			return if @_advancing
			return if @_options
			if @advance!
				return unless @_current -- command owns advancement until Story.Advance
				-- Reserve this line before the async refresh is scheduled.
				@_advancing = true
				thread ->
					@_advancing = false
					@updateDialogAsync!
			else
				@hide!
		@gslot "Story.Advance", ->
			@_advancing = false
			nextSentence!
		@confirm\slot "Tapped", nextSentence
		-- One advance per physical press; a held key must not skip dialogue.
		pressed = {}
		@keyboardEnabled = true
		@slot "KeyDown", (key) ->
			return unless key == "Return" or key == "Space"
			return if pressed[key]
			pressed[key] = true
			return unless @visible and not @reviewVisible
			nextSentence!
		@slot "KeyUp", (key) -> pressed[key] = nil
		@textArea\slot "NoneScrollTapped", nextSentence
		@reviewButton\slot "Tapped", ->
			return if @_advancing
			@reviewVisible = true
			@alignLayout!
		@reviewBack\slot "Tapped", -> @reviewVisible = false
		@reviewArea\slot "NoneScrollTapped", -> @reviewVisible = false
		@_dialog = with Dialog!
			.__modified = (key, value) -> switch key
				when "character"
					@figure\removeAllChildren!
					if value? and value ~= ""
						@figure\addChild StoryPortrait char: value
				when "name"
					@name.text = value if value?
				when "text"
					@text.text = value if value?
			.__updated = -> @alignLayout!
		@_reviews = {}
		@_reviewRevision = 0
		@visible = false

	-- 回顾列表按句全量重建，封顶避免超长对话的内存与重建成本无界增长。
	pushReview: (name, text) =>
		@_reviewRevision = (@_reviewRevision or 0) + 1
		@_reviews[] = :name, :text
		table.remove @_reviews, 1 if #@_reviews > 150

	updateDialogAsync: =>
		if @_preload
			for item in *@_preload
				figureFile = StoryPortrait.asset item
				Cache\loadAsync figureFile if figureFile
			@_preload = nil
		return unless @_current
		return if @_advancing
		@_advancing = true
		name, characterId = getCharName @_current
		figureFile = StoryPortrait.asset characterId
		Cache\loadAsync figureFile if figureFile
		text = @_current.text
		@pushReview name, text
		@_dialog.character = characterId
		@_dialog.name = name
		@_dialog.text = text
		@answerList\removeAllChildren!
		if @_options
			@continueIcon.visible = false
			count = #@_options
			for i = 1, count
				option = @_options[i]
				local optionName = getCharName option
				local optionText = option.text
				@answerList\addChild with Answer text: optionText
					\slot "Tapped", ->
						.touchEnabled = false
						thread ->
							sleep 0.3
							@pushReview optionName, optionText
							if @advance i
								thread -> @updateDialogAsync!
							else
								@hide!
			size = @answerList\alignItems 40
			@answerList.size = size
			@answerList\alignItems 40
		else
			@continueIcon.visible = true
		@_advancing = false

	showAsync: =>
		@updateDialogAsync!
		@visible = true
		@_viewScale = View.scale
		@_viewEffect = View.postEffect
		View.scale = 4 * @_viewScale
		:size = View
		blurH = with Pass "builtin:vs_sprite", "builtin:fs_spriteblurh"
			.grabPass = true
			\set "u_radius", size.width
		blurV = with Pass "builtin:vs_sprite", "builtin:fs_spriteblurv"
			.grabPass = true
			\set "u_radius", size.height
		View.postEffect = with SpriteEffect!
			for _ = 1, 3
				\add blurH
				\add blurV
		@gslot "AppChange", (settingName) -> if settingName == "Size"
			:width, :height = View.size
			blurH\set "u_radius", width
			blurV\set "u_radius", height
		emit "Story.Display", true

	hide: =>
		@gslot "AppChange", nil
		@emit "Ended"
		@removeFromParent!
		viewScale = @_viewScale
		viewEffect = @_viewEffect
		thread ->
			collectgarbage!
			Cache\removeUnused!
			emit "Story.Display", false
			View.scale = viewScale
			sleep!
			View.postEffect = viewEffect
